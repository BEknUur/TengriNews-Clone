msgid "Welcome to TengriNews, %(first_name)s!"
msgstr "TengriNews-қа қош келдіңіз, %(first_name)s!"

msgid "Hi %(first_name)s,"
msgstr "Сәлем %(first_name)s,"

msgid "Welcome to TengriNews."
msgstr "TengriNews-қа қош келдіңіз."

msgid "Your account %(email)s is ready."
msgstr "Сіздің аккаунтыңыз %(email)s дайын."

msgid "You can now read news and customize your feed."
msgstr "Енді сіз жаңалықтарды оқи аласыз және лентаны теңшей аласыз."

msgid "Best regards,"
msgstr "Құрметпен,"

msgid "TengriNews Team"
msgstr "TengriNews командасы"

msgid "Welcome email for user %(user_id)s has been sent."
msgstr "Пайдаланушы %(user_id)s үшін қош келу хаты жіберілді."

msgid "Passwords do not match."
msgstr "Құпия сөздер сәйкес келмейді."

msgid "Invalid credentials."
msgstr "Дұрыс емес қосымша деректер."

msgid "Account is disabled."
msgstr "Аккаунт ажыратылған."
